{
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "generate:api": "pnpm exec openapi-typescript ../contracts/openapi.yaml -o packages/api/src/schema.d.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "^5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "flatted": "^3.4.2",
      "svgo": "^3.3.5",
      "js-yaml": "^4.3.2",
      "ajv": "^6.14.0",
      "nanoid": "^3.3.18",
      "fast-uri": "^3.1.7",
      "postcss": "^8.5.28",
      "sharp": "^0.35.4"
    }
  }
}
