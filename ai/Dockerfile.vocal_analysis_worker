# 보컬 분석 워커 — 프로덕션: Lambda가 SQS 소비 후 RunTask, 컨테이너는 JOB_ID 로 1건 처리
# 빌드: cd ai && docker build -f Dockerfile.vocal_analysis_worker -t vocal-analysis-worker .

FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsndfile1 \
    git \
    build-essential \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/ ./scripts/

WORKDIR /app/scripts/vocal_analysis
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/scripts/vocal_analysis

# 런타임 HuggingFace 의존 완화: 빌드 시 ECAPA 가중치 캐시 (네트워크 필요, PREFETCH_ECAPA=0 으로 끌 수 있음)
ARG PREFETCH_ECAPA=1
RUN if [ "$PREFETCH_ECAPA" = "1" ]; then \
      python -c "from speechbrain.pretrained import EncoderClassifier; EncoderClassifier.from_hparams(source='speechbrain/spkrec-ecapa-voxceleb', savedir='pretrained_models/spkrec-ecapa-voxceleb')"; \
    fi

CMD ["python", "vocal_analysis_worker.py"]
